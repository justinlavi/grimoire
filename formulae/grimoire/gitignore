# This file belongs to the grimoire. The framework copies it in only when the
# grimoire has no .gitignore, and never overwrites it.

# Obsidian: the four settings files that everyone shares are tracked; every
# other file under .obsidian/ is per-user state.
.obsidian/*
!.obsidian/app.json
!.obsidian/graph.json
!.obsidian/core-plugins.json
!.obsidian/community-plugins.json

# Files the operating system creates
.DS_Store
Thumbs.db
desktop.ini

# Scratch files editors create
*~
*.swp

# publish/: the build fetches or generates these folders, so they are
# disposable. The committed publishing files are publish.json, build.sh,
# quartz.config.yaml, the CI file and any wrangler.jsonc.
publish/content/
publish/quartz/
publish/.framework/
publish/.quartz-clone/
